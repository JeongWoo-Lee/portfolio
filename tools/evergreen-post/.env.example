# YouTube Data API v3 키
#   https://console.cloud.google.com 에서 프로젝트 생성
#   -> "YouTube Data API v3" 사용 설정 -> 사용자 인증 정보 -> API 키
#   무료, 기본 할당량 하루 10,000 유닛 (이 도구는 1회 실행에 ~200~300 유닛)
YOUTUBE_API_KEY=

# Anthropic API 키 (--draft 쓸 때만)
#   https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
